{
  "//": "Settings for validate.py. See README.md next to this file.",

  "libraries": ["server", "engine2", "tier0", "soundsystem", "networksystem", "schemasystem", "materialsystem2"],

  "multi_match_signatures": {
    "NetworkVar::StateChanged": "compared against the first bytes of every NetworkVar_<field> wrapper (schema.cpp), so it matches many functions by design"
  },

  "field_offsets": [
    "CCSPointScriptEntity::ScriptComponent",
    "CNetworkGameServer::ClientList",
    "CTakeDamageInfo::HitGroup",
    "*::m_*",
    "*::sizeof"
  ],

  "class_aliases": {
    "ICvar": "CCvar",
    "IGameEventManager2": "CGameEventManager",
    "IGameEventSystem": "CGameEventSystem",
    "INetworkServerService": "CNetworkServerService",
    "ISource2GameClients": "CSource2GameClients",
    "ISource2GameEntities": "CSource2GameEntities",
    "ISource2Server": "CSource2Server"
  }
}
