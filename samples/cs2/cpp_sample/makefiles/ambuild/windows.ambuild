# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# Windows (MSVC) settings -- AMBuild twin of makefiles/cmake/windows.cmake.
import os

def ConfigureCxx(cxx, options):
  if options.debug == '1':
    cxx.cflags += ['/MTd']
    cxx.linkflags += ['/NODEFAULTLIB:libcmt']
  else:
    cxx.cflags += ['/MT']
  cxx.defines += [
    '_CRT_SECURE_NO_DEPRECATE',
    '_CRT_SECURE_NO_WARNINGS',
    '_CRT_NONSTDC_NO_DEPRECATE',
  ]
  cxx.cflags += [
    '/W3',
    '/Zi',
    '/EHsc',
    '/std:c++20',
    '/bigobj',
  ]
  cxx.cxxflags += ['/TP']

  cxx.linkflags += [
    '/SUBSYSTEM:WINDOWS',
    'kernel32.lib',
    'user32.lib',
    'gdi32.lib',
    'winspool.lib',
    'comdlg32.lib',
    'advapi32.lib',
    'shell32.lib',
    'ole32.lib',
    'oleaut32.lib',
    'uuid.lib',
    'odbc32.lib',
    'odbccp32.lib',
  ]

  # Optimization
  if options.opt == '1':
    cxx.cflags += ['/Ox', '/Zo']
    cxx.linkflags += ['/OPT:ICF', '/OPT:REF']

  # Debugging
  if options.debug == '1':
    cxx.cflags += ['/Od', '/RTC1']

  # Don't omit the frame pointer.
  # This needs to be after our optimization flags which could otherwise disable it.
  cxx.cflags += ['/Oy-']

  # WIN32, WIN64, COMPILER_MSVC* come from s2sdk-manifests' windows.ambuild.
  cxx.defines += ['_WINDOWS']

# The plugin binary, after SdkHelpers added the SDK's libraries (the Steam API
# among them): nothing Windows-only.
