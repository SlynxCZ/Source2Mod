import os, sys, json, importlib.util

def ResolveSource2ModSdk():
  # The SDK, resolved the same way cpp_sample resolves it: SOURCE2MOD_SDK.
  path = os.environ.get('SOURCE2MOD_SDK')
  if not path or not os.path.isdir(path):
    raise Exception('SOURCE2MOD_SDK is not set to a valid directory')
  return os.path.abspath(os.path.normpath(path))

# SdkPlugin.ambuild by absolute path (builder.Build() only reaches scripts in
# this tree). A script plugin takes two things from it: the include set and
# spcomp (--spcomp, else SPCOMP, else the PATH).
Source2ModSdk = builder.Eval(os.path.join(ResolveSource2ModSdk(), 'SdkPlugin.ambuild'), {})

# The build settings, split the same way as the CMake side (makefiles/cmake/):
# shared.ambuild <-> shared.cmake, linux.ambuild <-> linux.cmake,
# windows.ambuild <-> windows.cmake, AMBuilder <-> CMakeBuilder.cmake,
# package.ambuild <-> package.cmake.
Shared = builder.Import('makefiles/ambuild/shared.ambuild')
Linux = builder.Import('makefiles/ambuild/linux.ambuild')
Windows = builder.Import('makefiles/ambuild/windows.ambuild')

def LoadPluginMetadata():
  path = os.path.join(builder.sourcePath, 'plugin-metadata.json')
  with open(path, 'r', encoding='utf-8') as fp:
    return json.load(fp)

def LoadVersionGen():
  # The same generator the CMake build runs, imported rather than shelled out to
  # so the include's text can go through builder.AddOutputFile() and a metadata
  # edit retriggers the compile.
  path = os.path.join(builder.sourcePath, 'tools', 'version_gen.py')
  spec = importlib.util.spec_from_file_location('version_gen', path)
  module = importlib.util.module_from_spec(spec)
  spec.loader.exec_module(module)
  return module

plugin_metadata = LoadPluginMetadata()
version_gen = LoadVersionGen()

class SPPluginConfig(object):
  def __init__(self):
    self.scripting = Source2ModSdk.ScriptingIncludePath()
    self.spcomp = Source2ModSdk.FindSpcomp(builder.options.spcomp)
    self.binaries = []
    self.version_header_deps = []

    if builder.options.plugin_name is not None:
      self.plugin_name = builder.options.plugin_name
    else:
      self.plugin_name = plugin_metadata['name']

  def Platform(self):
    if builder.host.platform == 'windows':
      return Windows
    return Linux

  def generateVersioningHeader(self):
    builder.SetBuildFolder('/')

    # Metadata edits retrigger the compile through the command's inputs.
    builder.AddConfigureFile(os.path.join(builder.sourcePath, 'plugin-metadata.json'))

    shorthash = version_gen.git_shorthash(builder.sourcePath)
    text = version_gen.render(plugin_metadata, shorthash)

    self.version_header_deps += [
      builder.AddOutputFile(os.path.join('versioning', 'version_gen.inc'), text.encode('utf-8'))
    ]

  def ScriptCommand(self, source, output):
    spcomp = self.Platform().Spcomp(self)
    argv = [spcomp, source] + ['-i' + path for path in Shared.IncludePaths(builder, self)]
    argv += ['-o' + output]
    return argv

SPPlugin = SPPluginConfig()
SPPlugin.generateVersioningHeader()

BuildScripts = [
  'makefiles/ambuild/AMBuilder',
  'makefiles/ambuild/package.ambuild'
]

builder.Build(BuildScripts, { 'SPPlugin': SPPlugin })
