# vim: set ts=2 sw=2 tw=99 noet ft=python:
#
# The install layout -- AMBuild twin of makefiles/cmake/package.cmake.
import os

builder.SetBuildFolder('package')

# A script plugin drops into addons/source2mod/plugins as a .smx, next to the
# native ones. configs/, when the plugin has one, is copied over the package
# root as it is.
PLUGIN_FOLDER = os.path.join('cs2', 'addons', 'source2mod', 'plugins')

builder.AddFolder(PLUGIN_FOLDER)

for task in SPPlugin.binaries:
	builder.AddCopy(task, os.path.join(PLUGIN_FOLDER, SPPlugin.plugin_name + '.smx'))

configs = os.path.join(builder.sourcePath, 'configs')
for root, _, files in os.walk(configs):
	for f in files:
		src = os.path.join(root, f)
		dst = os.path.join('cs2', os.path.relpath(src, configs))
		builder.AddFolder(os.path.dirname(dst))
		builder.AddCopy(src, dst)
