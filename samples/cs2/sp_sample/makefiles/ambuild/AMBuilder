import os

# The plugin binary -- AMBuild twin of makefiles/cmake/CMakeBuilder.cmake:
# spcomp turns scripting/<name>.sp into <name>.smx.
source = os.path.join(builder.sourcePath, 'scripting', SPPlugin.plugin_name + '.sp')
output = SPPlugin.plugin_name + '.smx'

cmd = builder.AddCommand(
  inputs = [source] + SPPlugin.version_header_deps,
  argv = SPPlugin.ScriptCommand(source, output),
  outputs = [output],
)

SPPlugin.binaries += cmd
