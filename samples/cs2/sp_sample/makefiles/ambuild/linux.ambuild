#
# Linux settings -- AMBuild twin of makefiles/cmake/linux.cmake.
import os

# Nothing platform specific: a .smx is the same bytecode everywhere, and the
# SDK's SdkPlugin.ambuild finds spcomp (spcomp.exe) by itself.
def Spcomp(SPPlugin):
  return SPPlugin.spcomp
